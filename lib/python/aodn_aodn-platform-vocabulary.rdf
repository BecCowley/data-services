<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/379">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T06:35:16.610Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T06:37:49.255Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">SARAL</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the only flight of the SARAL programme. It operated between February 2013 and is operational until 2026, at an altitude of 800km, in a sunsynchronous orbit. Instrumentation: Advanced Data Collection System (also called "Argos-3"); Ka-band Altimeter; Doppler Orbitography and Radiopositioning Integrated by Satellite;  	Laser Retroreflector Array.</skos:definition>
	<skos:hiddenLabel xml:lang="en">CNES/ISRO - Satellite with ARGOS and AltiKa</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/380">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T06:41:06.862Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T06:52:05.738Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">Sentinel-3A</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 1st flight of the Sentinel-3 programme, providing SAR observation. It operated between February 2016 and is operational until 2027, at an altitude of 814km, in a sunsynchronous orbit. Instrumentation: Doppler Orbitography and Radiopositioning Integrated by Satellite; GPS Receiver; Laser Retro-Reflector; Micro-Wave Radiometer; Ocean and Land Colour Imager; Sea and Land Surface Temperature Radiometer; Synthetic Aperture Radar Altimeter.</skos:definition>
	<skos:hiddenLabel xml:lang="en">ESA/EC/EUMETSAT - Sentinel-3A</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/381"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/381">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T06:49:59.298Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T06:52:05.738Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">Sentinel-3B</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 2nd flight of the Sentinel-3 programme, providing SAR observation. It operated between April 2018 and is operational until 2028, at an altitude of 814km, in a sunsynchronous orbit. Instrumentation: Doppler Orbitography and Radiopositioning Integrated by Satellite; GPS Receiver; Laser Retro-Reflector; Micro-Wave Radiometer; Ocean and Land Colour Imager; Sea and Land Surface Temperature Radiometer; Synthetic Aperture Radar Altimeter.</skos:definition>
	<skos:hiddenLabel xml:lang="en">ESA/EC/EUMETSAT - Sentinel-3B</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/380"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/382">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T06:55:34.156Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T07:30:18.654Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">CFOSAT</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 1st flight of the CFOSAT programme. It operated between October 2018 and is operational until 2026, at an altitude of 500km, in a sunsynchronous orbit. Instrumentation: CFOSAT Scatterometer; Surface Waves Investigation and Monitoring instrument.</skos:definition>
	<skos:hiddenLabel xml:lang="en">NSOAS/CNES - Chinese-French Oceanography Satellite</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/383">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T06:59:35.740Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T07:22:25.800Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">OceanSat-2</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 2nd flight of the OceanSat programme. It operated between September 2009 and July 2023 at an altitude of 730km, in a sunsynchronous orbit. Instrumentation: OceanSat Scatterometer; Ocean Color Monitor; Radio Occultation Sounder of the Atmosphere.</skos:definition>
	<skos:hiddenLabel xml:lang="en">ISRO - Satellite for the Ocean - 2</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/385"/>
	<dcterms:valid xml:lang="en">2009-09-23/2023-07</dcterms:valid>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/384">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T07:13:26.396Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T07:22:33.326Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">OceanSat-3 (EOS-06)</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 3rd flight of the OceanSat programme renamed ESO-06. It operated between November 2022 and is operational until 2027 at an altitude of 723km, in a sunsynchronous orbit. Instrumentation: Ocean Color Monitor; Scatterometer for Oceansat-3; Advanced Data Collection System (called "Argos-4").</skos:definition>
	<skos:hiddenLabel xml:lang="en">ISRO - OceanSat-3 (EOS-06)</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/385"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/385">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T07:18:51.124Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T07:22:33.326Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">ScatSat-1</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the Gap-filler for the OSCAT instrument of OceanSat-2 of the OceanSat programme. It operated between September 2016 and February 2021 at an altitude of 732km, in a sunsynchronous orbit. Instrumentation: OceanSat Scatterometer.</skos:definition>
	<skos:hiddenLabel xml:lang="en">ISRO - ScatSat-1</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/383"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/384"/>
	<dcterms:valid xml:lang="en">2016-09-26/2021-02-28</dcterms:valid>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/386">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-06T03:21:41.920Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-06T03:23:27.674Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">Capitaine Tupaia</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:altLabel xml:lang="en">9V8363</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/32"/>
	<skos:definition xml:lang="en">Container ship vessel, which is currently flying the flag of Singapore (February, 2026).</skos:definition>
	<skos:hiddenLabel xml:lang="en">IMO:9410301</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<skos:scopeNote xml:lang="en">built:2010</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/387">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-06T03:42:50.740Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-06T03:43:39.310Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">Slocum Sentinel Glider</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/27"/>
	<skos:definition xml:lang="en">The Slocum Sentinel glider is 2.6 m long, 33 cm in diameter and weighs 171 kg.  Manufactured by Teledyne Webb Research Corporation, the glider is designed to operate in ocean waters, with a depth rating of 1000m, in extended missions.  Moving at an average glide speed of 0.75 knots,  the glider travels in a sawtooth pattern through the water navigating its way to a series of pre-programmed waypoints using GPS and altimeter measurements.  Operating on Lithium batteries, deployments can have a duration over 18+ months.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/863/">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdfs:label xml:lang="en">NOAA-8</rdfs:label>
	<owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</rdf:Description>

<rdf:Description rdf:about="http://www.w3.org/2002/07/owl#deprecated">
