<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/365">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T03:18:36.354Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T03:22:13.031Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">Sentinel-1C</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 3rd flight of the Sentinel-1 programme, providing SAR observation. It operated between December 2024 and is operational until 2034, at an altitude of 693km, in a sunsynchronous orbit. Instrumentation: Synthetic Aperture Radar (C-band), Automatic Identification System.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/49"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/50"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/366">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T03:47:11.360Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T03:51:21.720Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">GEOSat</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 1st flight of the GEOSat programme. It operated between March 1985 and January 1990 at an altitude of 785km, in a drifting orbit. Instrumentation: GEOSat Radar Altimeter.</skos:definition>
	<skos:hiddenLabel xml:lang="en">DoD/NASA - Geodetic Satellite</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/887"/>
	<dcterms:valid xml:lang="en">1985-03-12/1990-01-31</dcterms:valid>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/367">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T03:53:02.943Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T06:38:29.956Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">Sentinel-6A</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 1sr flight of the Sentinel-6 programme, also named "Sentinel-6 Michael Freilich". It operated between November 2020 and is operational until 2027, at an altitude of 1336km, in a drifting orbit. Instrumentation: Doppler Orbitography and Radiopositioning Integrated by Satellite; GPS Receiver; Laser Retroreflector Array; Global Navigation Satellite System - Radio Occultation; Poseidon-4; Radiation Monitor Unit (also referred to as NGRM); Advanced Microwave Radiometer - Climate Quality; High Resolution Microwave Radiometer.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/368">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T03:57:47.178Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:01:00.470Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">SWOT</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the only flight of the SWOT programme. It operated between December 2022 and is operational until 2029, at an altitude of 891km, in a drifiting orbit. Instrumentation: Poseidon-3C Altimeter; Ka-band Radar Interferometer; Microwave radiometer; Doppler Orbitography and Radiopositioning Integrated by Satellite; Laser Retroreflector Array; GPS Receiver.</skos:definition>
	<skos:hiddenLabel xml:lang="en">NASA/CNES - Surface Water and Ocean Topography</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/369">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:01:41.092Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:05:03.806Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">QuikSCAT</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the only flight of the QuickSCAT programme. It operated between June 1999 and November 2009 at an altitude of 803km, in a sunsynchronous orbit. Instrumentation: SeaWinds.</skos:definition>
	<skos:hiddenLabel xml:lang="en">NASA - Quick Scatterometer Mission</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<dcterms:valid xml:lang="en">1999-06-19/2009-11-23</dcterms:valid>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/370">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:06:43.874Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:09:44.259Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">ISS RapidScat</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">Mission consisting of hosting RapidScat on the International Space Station. Instrumentation: Rapid Scatterometer.</skos:definition>
	<skos:hiddenLabel xml:lang="en">NASA/CSA/DLR/ESA/JAXA/Roscosmos - Rapid Scatterometer on the ISS</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<dcterms:valid xml:lang="en">2014-09-21/2016-08-19</dcterms:valid>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/371">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:10:59.272Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:15:07.569Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">ERS-1</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 1st flight of the ERS programme. It operated between July 1991 and March 2000, at an altitude of 785km, in a sunsynchronous orbit. Instrumentation: Active Microwave Instrument - Synthetic Aperture Antenna; Active Microwave Instrument - Scatterometer; Along-Track Scanning Radiometer; Laser Retro-Reflector; Precise Range And Range-rate Equipment; Radar Altimeter; Micro-Wave Radiometer.</skos:definition>
	<skos:hiddenLabel xml:lang="en">ESA - European Remote-sensing Satellite - 1</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/372"/>
	<dcterms:valid xml:lang="en">1991-07-17/2000-03-10</dcterms:valid>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/372">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:14:59.845Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:18:32.346Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">ERS-2</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 2nd (last) flight of the ERS programme. It operated between April 1995 and July 2011, at an altitude of 785km, in a sunsynchronous orbit. Instrumentation: Active Microwave Instrument - Synthetic Aperture Antenna; Active Microwave Instrument - Scatterometer; Along-Track Scanning Radiometer - 2; Global Ozone Monitoring Experiment; Laser Retro-Reflector; Micro-Wave Radiometer; Precise Range And Range-rate Equipment; Radar Altimeter.</skos:definition>
	<skos:hiddenLabel xml:lang="en">ESA - European Remote-sensing Satellite - 2</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/371"/>
	<dcterms:valid xml:lang="en">1995-04-21/2011-07-06</dcterms:valid>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/373">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:19:51.683Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:24:32.570Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">Envisat</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the only flight of the Envisat programme. It operated between March 2002 and April 2012 at an altitude of 774km, in a sunsynchronous orbit. Instrumentation: Advanced Along-Track Scanning Radiometer; Advanced Synthetic Aperture Radar; Doppler Orbitography and Radiopositioning Integrated by Satellite; Global Ozone Monitoring by Occultation of Star; Laser Retro-Reflector; Medium Resolution Imaging Spectrometer; Michelson Interferometer for Passive Atmospheric Sounding; Micro-Wave Radiometer; Radar Altimeter - 2; Scanning Imaging Absorption Spectrometer for Atmospheric Cartography (limb-scanning component); Scanning Imaging Absorption Spectrometer for Atmospheric Cartography (nadir-scanning component.</skos:definition>
	<skos:hiddenLabel xml:lang="en">ESA - Environmental Satellite</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<dcterms:valid xml:lang="en">2002-03-01/2012-04-08</dcterms:valid>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/374">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:25:45.677Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T04:33:03.866Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">CryoSat-2</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 1st flight of the CryoSat programme. It operated between April 2010 and is operational until 2028, at an altitude of 717km, in a drifting orbit. Instrumentation: Doppler Orbitography and Radiopositioning Integrated by Satellite; Laser Retro-Reflector; SAR Interferometer Radar Altimeter.</skos:definition>
	<skos:hiddenLabel xml:lang="en">ESA - CryoSat-2</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/375">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T06:07:27.440Z</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-03T06:20:25.730Z</dcterms:modified>
	<dcterms:contributor rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<skos:prefLabel xml:lang="en">HY-2A</skos:prefLabel>
	<dcterms:creator rdf:resource="http://editor.vocabs.ands.org.au/user/eMII_Atkins.Natalia_Admin"/>
	<dc:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eMarine Information Infrastructure (eMII)</dc:publisher>
	<dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Ocean Data Network Platform Register</dc:source>
	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 1st flight of the HY-2 programme. It operated between August 2011 and 2022 at an altitude of 975km, in a sunsynchronous orbit. Instrumentation: Doppler Orbitography and Radiopositioning Integrated by Satellite; Laser Retroreflector Array; Microwave Radiometer Imager; HY Scatterometer; Calibration Microwave Radiometer; Radar Altimeter.</skos:definition>
	<skos:hiddenLabel xml:lang="en">NSOAS/CAST - Hai Yang 2A</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/376"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/377"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/378"/>
	<dcterms:valid xml:lang="en">2011-08-16/2022</dcterms:valid>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/376">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
