	<skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L06/current/65"/>
	<skos:definition xml:lang="en">This satellite was the 4th flight of the HY-2 programme. It operated between May 2021 and is operational until 2026 at an altitude of 973km, in a drifting orbit. Instrumentation: Doppler Orbitography and Radiopositioning Integrated by Satellite; Laser Retroreflector Array; Calibration Microwave Radiometer; HY Scatterometer; Radar Altimeter.</skos:definition>
	<skos:hiddenLabel xml:lang="en">NSOAS/CAST - Hai Yang 2D</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
