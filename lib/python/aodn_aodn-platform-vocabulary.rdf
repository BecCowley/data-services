	<skos:definition xml:lang="en">Utility vessel, which is currently flying the flag of Australia (August, 2025).</skos:definition>
	<skos:hiddenLabel xml:lang="en">IMO:9131905</skos:hiddenLabel>
	<skos:inScheme rdf:resource="http://vocab.aodn.org.au/def/platform/1"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.aodn.org.au/def/platform/entity/364">
