	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/37"/>
	<skos:related rdf:resource="http://vocab.aodn.org.au/def/platform/entity/38"/>
	<dcterms:valid xml:lang="en">2015-05-23/2022-07-25</dcterms:valid>
	<box xmlns="http://www.georss.org/georss/" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-27.3175 154.0017 -27.3175 154.0017</box>
</rdf:Description>

